{
  // dna-ts is a DNA package: dna/ is authored by hand and is the last
  // layer of its own instantiation. "role": "dna" is also what makes this
  // package usable as a layer at all — a dna/ folder alone does not.
  "version": 6,
  "role": "dna",

  // The parent DNA. Declared as a regular dependency in package.json, so
  // pnpm installs it transitively for every consumer.
  "layers": ["@tssuite/base-dna"]
}
